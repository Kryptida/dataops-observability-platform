# ------------------------------------------------------------
# Terraform: local state, working directories, and plans
# ------------------------------------------------------------

**/.terraform/
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info
*.tfplan
*.plan
tfplan
crash.log
crash.*.log

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform variable files may contain sensitive values
*.tfvars
*.tfvars.json
*.auto.tfvars
*.auto.tfvars.json

# Keep the dependency lock file tracked:
# .terraform.lock.hcl

# ------------------------------------------------------------
# Credentials and environment configuration
# ------------------------------------------------------------

.env
.env.*
!.env.example
!.env.*.example
*credentials*
*.credentials
credentials/
secrets/

# ------------------------------------------------------------
# Private keys and sensitive key containers
# ------------------------------------------------------------

*.pem
*.key
*.ppk
*.p12
*.pfx
*.jks
*.keystore
id_*
dataops-key
dataops-key.*
github-key
github-key.*

# ------------------------------------------------------------
# Logs and diagnostic output
# ------------------------------------------------------------

*.log

# ------------------------------------------------------------
# Editor and operating-system files
# ------------------------------------------------------------

*.swp
*.swo
*~
.DS_Store
Thumbs.db
